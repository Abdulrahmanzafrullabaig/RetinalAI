# Use Node.js 18 alpine image as base
FROM node:18-alpine

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY . .

# Expose port
EXPOSE 3000

# Build the app
RUN npm run build

# Serve the app
CMD ["npm", "run", "preview", "--", "--host", "0.0.0.0", "--port", "3000"]